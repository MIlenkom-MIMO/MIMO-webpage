<!-- JUMBOTRON SECTION -->
<div class="jumbotron p-2 m-0">
    <div class="container text-center align-items-center">
        <h3 class="text-warning font-weight-bold" id="heading">@ViewBag.Message</h3>
    </div>
    <div class="container d-flex align-items-end">
        @Html.ActionLink("Home", "Index", null, new { @class = "text-primary small font-weight-bold pr-2" })
        <a class="text-primary small font-weight-bold pr-2" id="Divisor1" href="#">/</a>
        @Html.ActionLink("Calculations", "Calculations", null, new { @class = "text-primary small font-weight-bold pr-2" })
        <a class="text-primary small font-weight-bold pr-2" id="link3" href="#"></a>
    </div>
</div>
<!-- END JUMBOTRON -->
<!-- CONTENT SECTION -->
<div id="page-content" class="text-center">

    <br>

    <p class="text-success small text-left">
        Excel calculations spreadsheets for most useful metering calculations. Calculations are executed
        using user defined functions, and additional macro functionality. Calculations are free to use and have been verified against relevant standards. The caclulations
        are still under development and more calculations will be added, as soon they are developed. Spreadsheets are locked.
    </p>

    <div class="container">

        <!-- ROW 1 CONTENT -->
        <div class="row p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook 1 - Gas Properties_F0.xlsm")">

            <div class="col-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 1: GAS PROPERTIES
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    Calculates gas density, standard and line compressibility, and heating value. Supports natural gas composition up decane
                    or C6+ properties. Standards in use are AGA8, ISO6976 and GPA2172. Calculation of LNG and LPG liquid density.
                </p>
            </div>

        </div>


        <!-- ROW 2 CONTENT -->
        <div class="row bg-gray p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook 2 - Oil Properties_F1.xlsm")">

            <div class="col-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 2: OIL PROPERTIES
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    Oil density and volume intraconversions. Calculation of observed, base and alternate density and volume at various
                    oil conditions. Utilises API MPM 11.1 Tables 2004 and 1980.
                </p>
            </div>

        </div>


        <!-- ROW 3 CONTENT -->
        <div class="row p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook%203%20-%20Measurement%20Tables_F0.xlsm")">

            <div class="col-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 3: MEASUREMENT TABLES
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    Crude oil, lube oil and refined products measurement tables showing density and compressibility of
                    oil products at the defined range of temperature and pressure conditions. Uses API MPM 2005 and 1980 tables.
                </p>
            </div>

        </div>


        <!-- ROW 4 CONTENT -->
        <div class="row bg-gray p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook%204%20-%20Data%20Extractor_F0.xlsm")">

            <div class="col-md-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 4: DATA EXTRACTOR
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    Data extractor is a tool that extacts data from other Excel sheets. Extractor can extract values from multiple or single excel spreadsheet. User
                    needs to specify specific keyword to search for, offset from found value and a target spreadsheet. Progress indicator is included to track files
                    being processed.
                </p>
            </div>

        </div>


        <!-- ROW 5 CONTENT -->
        <div class="row p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook 5 - S600 Data Extractor-F0.xlsm")">

            <div class="col-md-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 5: S600 DATA EXTRACTOR (TEXT FILES)
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    S600 Data extractor is a tool that extacts data from S600 Flow computer configuration reports. Extractor can extact data from multiple
                    configuration reports. Requid input is the specific keyword, and offset from the found value. Progress indicator is inlcuded to track files
                    being processed.
                </p>
            </div>

        </div>


        <!-- ROW 6 CONTENT -->
        <div class="row bg-gray p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook%206%20-%20Gas%20Orifice%20Flow%20Calculation_F0.xlsm")">

            <div class="col-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 6: ORIFICE CALCULATIONS
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    Calculation of orifice mass flowrate, pressure loss and orifice design dimensions.
                    Calculations per standards ISO 5167:2003, AGA3 and API MPM 14.3.
                </p>
            </div>

        </div>


        <!-- ROW 7 CONTENT -->
        <div class="row bg-gray p-1 clickable"
             data-href="@Url.Content("~/Modules/workbook 7 - Proving Control Charts_F0.xlsm")">

            <div class="col-auto p-2 text-left">
                <img src="~/img/Excel_Icon_RED1.jpg"
                     class="img-responsive" />
            </div>

            <div class="col-md-2 p-2 text-left">
                <p class="text-secondary small font-weight-bold">
                    WORKBOOK 7: PROVING CONTROL CHARTS
                </p>
            </div>

            <div class="col p-2 text-justify">
                <p class="text-dark small">
                    Workbook for collection and storage of meter proving data, construction of fixed and moving average proving control charts per guidelines of API MPM 13.1 and API MPM 13.2.
                </p>
            </div>

        </div>

        <br>

    </div>

</div>
<!-- END CONTENT SECTION -->