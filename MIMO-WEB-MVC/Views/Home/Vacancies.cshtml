@model MIMOWEB_ENG.Models.Candidate

<script>

    $("#mybtn").click(function () {
        document.getElementById("form").reset();
        $("#modal-window").modal();
    });

</script>

<!-- MODAL WINDOW UNCERTAINTY -->
<div class="modal fade" id="CarModal" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-center bg-success">
                <p class="text-white font-weight-bold" id="modal-window">APPLY FOR POSITION</p>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body text-center">
                <!-- CONTENT SECTION -->

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="row md-4 justify-content-center m-0">
                        <div class="col-lg-4 col-sm-6 m-0">
                            <div class="form-group m-0">
                                @Html.TextBoxFor(m => m.Name, new { @placeholder = "Name*", @class = "form-control input-box" })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger text-left small" })
                            </div>
                        </div>

                        <div class="col-lg-4 col-sm-6 m-0">
                            <div class="form-group">
                                @Html.EditorFor(model => model.Surname, new { htmlAttributes = new { @class = "form-control input-box", @placeholder = "Surname*" } })
                                @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger text-left small" })
                            </div>
                        </div>
                    </div>

                    <div class="row md-4 justify-content-center m-1">
                        <div class="col-lg-4 col-sm-6 m-0">
                            <div class="form-group">
                                @Html.EditorFor(model => model.Mail, new { htmlAttributes = new { @class = "form-control input-box", @placeholder = "E-mail*" } })
                                @Html.ValidationMessageFor(model => model.Mail, "", new { @class = "text-danger text-left small" })
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-6 m-0">
                            <div class="form-group">
                                @Html.EditorFor(model => model.Telephone, new { htmlAttributes = new { @class = "form-control input-box", @placeholder = "Telephone*" } })
                                @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger text-left small" })
                            </div>
                        </div>
                    </div>

                    <div class="row md-4 justify-content-center m-1">
                        <div class="col-md-8 m-0">
                            <div class="form-group">
                                @Html.EditorFor(model => model.Cover, new { htmlAttributes = new { @class = "form-control input-box", @placeholder = "Cover Letter (optional)*" } })
                                <p class="text-primary small">Fields marked with * are required</p>
                            </div>
                        </div>
                    </div>

                    <div class="row md-1 justify-content-center m-1">
                        <div class="col-md-8 m-0">
                            <div class="input-group input-box">
                                <div class="input-group-prepend">
                                    <span class="input-group-text" id="inputGroupFileAddon01">Upload</span>
                                </div>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="inputGroupFile01"
                                           aria-describedby="inputGroupFileAddon01">
                                    <label class="custom-file-label text-left" for="inputGroupFile01">Choose file</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row md-4 justify-content-end m-1">
                        <div class="col-sm">
                            <input type="submit" value="Submit" class="btn btn-success btn-lg" id="mybtn" />
                        </div>
                    </div>
                    <br>
                }

                <!-- END OF CONTAINER-->

            </div>
        </div>
    </div>
</div>

<!-- CONTENT SECTION -->
<div id="page-content" class="text-center">


    <br>
    <p class="text-success font-weight-bold">MIMO Vacancies - Staff provision</p>
    <br>

    <br>
    <br>
    <br>
    <br>
