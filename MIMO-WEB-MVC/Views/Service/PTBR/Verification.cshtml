
<!-- MODAL WINDOW - VERIFICATION & TESTING PAGE -->
<div class="modal fade" id="VerModal" role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-center">
                <p class="text-white font-weight-bold">TEST EQUIPMENT</p><button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <!-- CAROUSEL SECTION -->
                <div id="car" class="carousel slide" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#car" data-slide-to="0" class="active"></li>
                        <li data-target="#car" data-slide-to="1"></li>
                        <li data-target="#car" data-slide-to="2"></li>
                        <li data-target="#car" data-slide-to="3"></li>
                        <li data-target="#car" data-slide-to="4"></li>
                        <li data-target="#car" data-slide-to="5"></li>
                    </ol>

                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img class="d-block img-fluid m-auto" src="~/img/DE-1.jpg" alt="First slide">
                            <div class="carousel-caption bg-dark my-2">
                                <p class="font-weight-bold">Beamex Multicalibrator</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img class="d-block img-fluid m-auto" src="~/img/DE-2.jpg" alt="Second slide">
                            <div class="carousel-caption bg-dark my-2">
                                <p class="font-weight-bold">Pressure Handpump</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img class="d-block img-fluid m-auto" src="~/img/DE-3.jpg" alt="Third slide">
                            <div class="carousel-caption bg-dark my-2">
                                <p class="font-weight-bold">Temperature Probe</p>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <img class="d-block img-fluid m-auto" src="~/img/DE-5.jpg" alt="Fifth slide">
                            <div class="carousel-caption bg-dark my-2">
                                <p class="font-weight-bold">Beamex Pressure Module</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img class="d-block img-fluid m-auto" src="~/img/DE-6.jpg" alt="Sixth slide">
                            <div class="carousel-caption bg-dark my-2">
                                <p class="font-weight-bold">Connection leads</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img class="d-block img-fluid m-auto" src="~/img/DE-7.jpg" alt="Seventh slide">
                            <div class="carousel-caption bg-dark my-2">
                                <p class="font-weight-bold">Decade Resistance Box</p>
                            </div>
                        </div>

                    </div>
                    <a class="carousel-control-prev" href="#car" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#car" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">next</span>
                    </a>
                </div>
                <!-- END CAROUSEL SECTION -->
            </div>
        </div>
    </div>
</div>

<!-- JUMBOTRON SECTION -->
<div class="jumbotron p-2 m-0">
    <div class="container text-center align-items-center">
        <h3 class="text-warning font-weight-bold" id="heading">@ViewBag.Message</h3>
    </div>
    <div class="container d-flex align-items-end">
        @Html.ActionLink("Home", "index","home", null, new { @class = "text-primary small font-weight-bold pr-2" })
        <a class="text-primary small font-weight-bold pr-2" href="#">/</a>
        @Html.ActionLink("Service", "service","service", null, new { @class = "text-primary small font-weight-bold pr-2" })
        <a class="text-primary small font-weight-bold pr-2" href="#">/</a>
        @Html.ActionLink("Verification", "verification","service", null, new { @class = "text-primary small font-weight-bold pr-2" })

    </div>
</div>
<!-- END JUMBOTRON -->

<!-- CONTENT SECTION -->
<div id="page-content">
    <div class="row">
        <div class="col-lg p-4 border text-justify">
            <h5 class="text-success text-left">THE IMPORTANCE OF VERIFICATION</h5>
            <p class="text-dark small">
                Verification is essential part of all measurement systems and is present in all stages, from initial conceptual design down to final testing and commissioning.
                It is essentail that before metering skids are installed, modified or upgraded they have to be properly tested.
            </p>
            <p class="text-dark small">
                Series of test are performed to assure
                they are fit for purpose, and that they operated and maintained per design guidelines and best industry practises. The very same testing procedures that will be used
                need to be reviewed for suitability.
            </p>
            <h5 class="text-success text-left">MIMO VERIFICATION SERVICES</h5>
            <p class="text-dark small">
                We can assist you with a review of design documentation, and participate in testing of metering systems performed by vendor. We also offer
                independent post-commissioning verification of upgraded or new metering systems. These services can be done under existing support contracts
                or as standalone consultancy services.
            </p>

            <div class="d-flex justify-content-between border-regular">
                <a class="nav-link text-primary small text-left font-weight-bold" href="#vdata1" data-toggle="collapse" aria-expanded="false" aria-controls="vdata1">Review of design documentation</a>
                <a class="nav-link text-primary small font-weight-bold" href="#vdata1" data-toggle="collapse" aria-expanded="false" aria-controls="vdata1">▽</a>
            </div>
            <div class="collapse border border-primary collapse-bg" id="vdata1">
                <p class="text-primary small pl-3 pr-3 pt-2 text-left">
                    Review of design documentation will confirm that proposed solution is in agreement with measurement standards, industry practises and goverment legislation. Operation and maintenance
                    requirements are checked. Verify that system uncertainy has been estimated, and is adequate for purpose.
                </p>
            </div>
            <div class="d-flex justify-content-between border-regular">
                <a class="nav-link text-primary small text-left font-weight-bold" href="#vdata2" data-toggle="collapse" aria-expanded="false" aria-controls="vdata2">Review of maintenance procedures</a>
                <a class="nav-link text-primary small font-weight-bold" href="#vdata2" data-toggle="collapse" aria-expanded="false" aria-controls="vdata2">▽</a>
            </div>
            <div class="collapse border border-primary collapse-bg" id="vdata2">
                <p class="text-primary small pl-3 pr-3 pt-2 text-left">
                    Assess that maintenance procedures are fit for purpose, and are executed per defined schedules and according to approved maintenance philosophy. Check that
                    suitable test equipment is used, and calibrated at defined intervals. Check used calculations and tolerances.
                </p>
            </div>
            <div class="d-flex justify-content-between border-regular">
                <a class="nav-link text-primary small text-left font-weight-bold" href="#vdata3" data-toggle="collapse" aria-expanded="false" aria-controls="vdata3">Review of Uncertainty calculations</a>
                <a class="nav-link text-primary small font-weight-bold" href="#vdata3" data-toggle="collapse" aria-expanded="false" aria-controls="vdata3">▽</a>
            </div>
            <div class="collapse border border-primary collapse-bg" id="vdata3">
                <p class="text-primary small pl-3 pr-3 pt-2 text-left">
                    Review of metering uncertainty spreadsheets and verify generated results are correct and reflect the condition of the installed equipment.
                </p>
            </div>
            <div class="d-flex justify-content-between border-regular">
                <a class="nav-link text-primary small text-left font-weight-bold" href="#vdata4" data-toggle="collapse" aria-expanded="false" aria-controls="vdata4">Review of commissioning procedures</a>
                <a class="nav-link text-primary small font-weight-bold" href="#vdata4" data-toggle="collapse" aria-expanded="false" aria-controls="vdata4">▽</a>
            </div>
            <div class="collapse border border-primary collapse-bg" id="vdata4">
                <p class="text-primary small pl-3 pr-3 pt-2 text-left">
                    Review and assess that commissioning procedures and tests are adequate and detailed enough for metering system that will be commissioned.
                    Make sure all relevant tests will be considered.
                </p>
            </div>
            <div class="d-flex justify-content-between border-regular">
                <a class="nav-link text-primary small text-left font-weight-bold" href="#vdata5" data-toggle="collapse" aria-expanded="false" aria-controls="vdata5">Witnessing FAT ad SAT testing</a>
                <a class="nav-link text-primary small font-weight-bold" href="#vdata5" data-toggle="collapse" aria-expanded="false" aria-controls="vdata5">▽</a>
            </div>
            <div class="collapse border border-primary collapse-bg" id="vdata5">
                <p class="text-primary small pl-3 pr-3 pt-2 text-left">
                    Entails independent review and witnessing of factory and site acceptance tests to make sure build system is functioning properly and per design recommendations.
                    Verification that all flow computer parameters and meter settings are correct and per manufacturer's recommendations.
                </p>
            </div>
            <!-- BUTTON LINK TO CONTACT US SECTION-->
            <br>
            <div class="p-0 align-items-end">
                @Html.ActionLink("Want to know more contact us", "Contact","Home", null, new { @class = "btn btn-info btn-lg btn-block" })
            </div>
        </div>
        <div class="col-lg p-4 border text-justify">
            <h5 class="text-success text-left">METERING TEST EQUIPMENT</h5>
            <p class="text-dark small">
                Most common test equipment that used for calibration and verificaton purposes, is shown below. Test equipment must be
                calibrated and certified every 12 months, by an UKAS accredited laboratory, or equivalent depending on country. Certified test equipment
                is an essential part of nearly all preventive and corrective maintenance procedures, and is also used to troubleshoot equipment and determining
                the root causes of failures.
            </p>
            <a class="cursor-pointer" data-toggle="modal" data-target="#VerModal"><img src="~/img/DE-0.jpg" class="img-thumbnail border-warning" /></a>
        </div>
    </div>
</div>
<!-- END CONTENT SECTION -->
